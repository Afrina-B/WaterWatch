# WaterWatch Backend Configuration
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
HOST=0.0.0.0
SECRET_KEY=waterwatch-dev-secret-change-in-prod

# Database
# Default: SQLite file in backend/instance/waterwatch.db
DATABASE_URL=sqlite:///waterwatch.db

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Background Simulator for Node 2 & Node 3
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=4

# Optional MQTT Configuration
MQTT_ENABLED=false
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=waterwatch
